#!/usr/bin/env bash
#SBATCH --job-name=timed-dataserver
#SBATCH --account={{ account }}
#SBATCH --partition={{ partition }}
#SBATCH --time={{ time }}
#SBATCH --cpus-per-task={{ cpus }}
#SBATCH --mem={{ mem }}
#SBATCH --output={{ output }}

set -euo pipefail
umask 077
mkdir -p "$(dirname "{{ output }}")"
{% for module in module_loads %}
module load {{ module | shellquote }}
{% endfor %}
{{ command }}
