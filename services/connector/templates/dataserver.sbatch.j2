#!/usr/bin/env bash
#SBATCH --job-name=timed-dataserver
#SBATCH --account={{ account }}
{% if partition %}#SBATCH --partition={{ partition }}
{% endif %}#SBATCH --time={{ time }}
#SBATCH --cpus-per-task={{ cpus }}
{% if mem %}#SBATCH --mem={{ mem }}
{% endif %}#SBATCH --output={{ output }}

set -euo pipefail
umask 077
mkdir -p "$(dirname "{{ output }}")"
{% for module in module_loads %}
module load {{ module | shellquote }}
{% endfor %}
{{ command }}
