---
import ConnectPanel from "../components/ConnectPanel";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Connect | TIMED">
  <p class="eyebrow">Connect</p>
  <h1>Microscopy data,<br />viewed where it lives</h1>
  <p class="lede">
    Start a private data server beside your OME-Zarr data. Credentials pass only
    through the local connector, and the browser requests only the image chunks
    needed for the current view.
  </p>

  <section class="panel" aria-labelledby="connect-heading">
    <h2 id="connect-heading">Connect</h2>
    <ConnectPanel client:load />
  </section>
</Layout>
