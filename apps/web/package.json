{
  "name": "@timed/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "gen:api": "uv run timed-connector export-openapi > src/lib/api/connector.openapi.json && uv run timed-dataserver export-openapi > src/lib/api/dataserver.openapi.json && openapi-typescript src/lib/api/connector.openapi.json -o src/lib/api/connector-schema.ts && openapi-typescript src/lib/api/dataserver.openapi.json -o src/lib/api/dataserver-schema.ts",
    "preview": "astro preview",
    "test": "uv run python ../../scripts/run_e2e.py",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "@deck.gl/widgets": "9.4.0",
    "@hms-dbmi/viv": "0.23.0",
    "@vivjs/views": "0.23.0",
    "@luma.gl/constants": "9.4.2",
    "@luma.gl/core": "9.4.2",
    "@luma.gl/engine": "9.4.2",
    "@luma.gl/shadertools": "9.4.2",
    "@luma.gl/webgl": "9.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.3.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
